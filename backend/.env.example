# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Get this from MongoDB Atlas → Connect → Drivers → Node.js
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# Replace <dbname> with: ai_code_review
MONGODB_URI=

# ─── GitHub App ───────────────────────────────────────────────────────────────
# GITHUB_APP_ID: found in your GitHub App settings page (a number, e.g. 123456)
GITHUB_APP_ID=

# GITHUB_APP_PRIVATE_KEY: *** PRODUCTION / RENDER ***
# Paste the FULL content of your private-key.pem here (including BEGIN/END lines).
# Render stores multi-line values correctly in its dashboard.
# Leave blank in local dev — use GITHUB_APP_PRIVATE_KEY_PATH instead.
GITHUB_APP_PRIVATE_KEY=

# GITHUB_APP_PRIVATE_KEY_PATH: *** LOCAL DEVELOPMENT ***
# Path to the .pem file downloaded from GitHub App settings.
# The .pem file is listed in .gitignore — never commit it.
GITHUB_APP_PRIVATE_KEY_PATH=./private-key.pem

# GITHUB_WEBHOOK_SECRET: the random string you set when creating the GitHub App
GITHUB_WEBHOOK_SECRET=

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ─── CORS — Frontend URL ──────────────────────────────────────────────────────
# Production (set on Render): your Vercel URL, e.g. https://ai-code-review.vercel.app
# Multiple origins: comma-separate them, e.g. https://ai-code-review.vercel.app,https://preview.vercel.app
# Leave as localhost:5173 for local development (Vite proxy handles it automatically).
FRONTEND_URL=http://localhost:5173
