# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Get this from MongoDB Atlas → Connect → Drivers
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=

# ─── GitHub App ───────────────────────────────────────────────────────────────
# Set up in Phase 1 — leave blank for now
# GITHUB_APP_ID: found in your GitHub App settings page
GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH: path to the .pem file downloaded from GitHub App settings
# The .pem file itself is listed in .gitignore — never commit it
GITHUB_APP_PRIVATE_KEY_PATH=./private-key.pem
# GITHUB_WEBHOOK_SECRET: a random string you set when creating the GitHub App
GITHUB_WEBHOOK_SECRET=

# ─── OpenAI ───────────────────────────────────────────────────────────────────
# Set up in Phase 2
OPENAI_API_KEY=

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Production Vercel URL — set on Render in Phase 5
FRONTEND_URL=http://localhost:5173
