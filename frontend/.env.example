# ─── Frontend environment variables ───────────────────────────────────────────
#
# VITE_ prefix is REQUIRED for Vite to expose variables to client-side code.
# Unprefixed variables are build-time only and NOT visible in the browser.
#
# Usage:
#   Development: no .env needed — Vite proxy routes /api to localhost:3000
#   Production (Vercel): set VITE_API_URL in Vercel dashboard → Settings → Environment Variables

# VITE_API_URL: the full URL of your Render backend (no trailing slash).
# Leave blank in development — the Vite proxy handles it.
# Example: https://ai-code-review-backend.onrender.com
VITE_API_URL=
